generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    address     String  @unique
    chainId     String
    provider    String?
    icon        String?
    url         String?
    createdAt   Int
    lastLoginAt Int
}
